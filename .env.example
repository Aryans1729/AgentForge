# Copy to .env and change values. .env is git-ignored; never commit it.
POSTGRES_USER=enterprisegym
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprisegym
EG_DB_PORT=5433

# Used by the app and Alembic.
EG_DATABASE_URL=postgresql+psycopg://enterprisegym:change-me@127.0.0.1:5433/enterprisegym
# Used by the Postgres test suite. Tables here are dropped freely; name must end in _test.
EG_TEST_DATABASE_URL=postgresql+psycopg://enterprisegym:change-me@127.0.0.1:5433/enterprisegym_test
